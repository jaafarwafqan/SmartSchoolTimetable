<Project>
  <!-- Shared compiler and analyzer settings for every project in src/ and tests/. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The application version shown in the app and recorded with every backup (docs/UPGRADE_AR.md): the major number follows the delivery phase. -->
    <Version>5.0.0</Version>
  </PropertyGroup>
</Project>
