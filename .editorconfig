root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,ts,tsx,js,css,html,md,yml,yaml}]
indent_size = 2

[*.{cs,csproj,props}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:silent
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_var_elsewhere = true:silent

# Analyzer severities (CA rules come from AnalysisLevel=latest-recommended in Directory.Build.props).
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0044.severity = warning

# EF Core migrations are tool-generated (or follow the generator's shape) and are excluded from style analysis.
[**/Migrations/*.cs]
generated_code = true
